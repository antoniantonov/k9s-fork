#!/usr/bin/expect -f
# SPDX-License-Identifier: Apache-2.0
# Copyright Authors of K9s

set timeout 25
foreach {var default} {K9S_IMAGE k9s:latest KUBECONFIG_MOUNT .kube/k9s-netpol.internal.kubeconfig CLUSTER_PREFIX netpol-demo DOCKER_NETWORK kind EXPECT_LOG_DIR .github/skills/netpol-graph-testing/runs/syntax-check} {
  if {![info exists env($var)]} { set env($var) $default }
}
set image $env(K9S_IMAGE)
set kubeconfig $env(KUBECONFIG_MOUNT)
set prefix $env(CLUSTER_PREFIX)
set network $env(DOCKER_NETWORK)
set log_dir $env(EXPECT_LOG_DIR)
set ns_app "${prefix}-app"
set ns_edge_src "${prefix}-edge-src"
set ns_edge_dst "${prefix}-edge-dst"
set ns_edge_other "${prefix}-edge-other"
set suite known
if {[info exists env(SMOKE_SUITE)]} { set suite $env(SMOKE_SUITE) }
set probe_id ""
if {[info exists env(PROBE_ID)]} { set probe_id $env(PROBE_ID) }
set screen_rows 50
set screen_columns 200
set case_name "startup"
set failures 0
set case_failed 0
set case_verdict 1
set verdicts [dict create]
set started_cases [dict create]
set container "k9s-netpol-smoke-[pid]"
set helper_file "[file dirname [info script]]/k9s-screen-assertions.exp"
set syntax_only [expr {[info exists env(EXPECT_SYNTAX_CHECK)] && $env(EXPECT_SYNTAX_CHECK) eq "1"}]
set initial_procs [info procs]
if {$syntax_only} {
  set syntax_sources [dict create]
  foreach path [list [info script] $helper_file] {
    set source_file [open $path r]
    set source_text [read $source_file]
    close $source_file
    if {![info complete $source_text]} {
      puts stderr "incomplete Tcl command in $path"
      exit 1
    }
    dict set syntax_sources $path $source_text
  }
}
source $helper_file

set edge_pairs [list \
  [list cnp-overlap cnp-client $ns_edge_src cnp-server $ns_edge_dst Allowed {TCP/8081}] \
  [list cnp-mismatch cnp-client $ns_edge_src cnp-mismatch $ns_edge_dst Disallowed {no ports}] \
  [list cnp-egress-deny cnp-client $ns_edge_src cnp-denied $ns_edge_dst Disallowed {no ports}] \
  [list cnp-ingress-deny cnp-blocked $ns_edge_src cnp-server $ns_edge_dst Disallowed {no ports}] \
  [list cnp-unmatched-source control $ns_edge_other cnp-server $ns_edge_dst Disallowed {no ports}] \
  [list cnp-unmatched-target cnp-client $ns_edge_src control $ns_edge_other Disallowed {no ports}] \
  [list ccnp-overlap ccnp-client $ns_edge_src ccnp-server $ns_edge_dst Allowed {TCP/9092}] \
  [list ccnp-egress-deny ccnp-client $ns_edge_src ccnp-denied $ns_edge_dst Disallowed {no ports}] \
  [list ccnp-unmatched-source control $ns_edge_other ccnp-server $ns_edge_dst Disallowed {no ports}] \
  [list ccnp-unmatched-target ccnp-client $ns_edge_src control $ns_edge_other Disallowed {no ports}] \
  [list istio-ports authz-client $ns_edge_src authz-server $ns_edge_dst Allowed {TCP/8080, UDP/5353, SCTP/9000}] \
  [list istio-no-tcp authz-client $ns_edge_src authz-no-tcp $ns_edge_dst Allowed {UDP/5353, SCTP/9000}] \
  [list istio-empty-allow authz-client $ns_edge_src authz-closed $ns_edge_dst Disallowed {no ports}] \
]
set known_cases {
  launch-npg-view subject-picker-kinds direction-toggles-placeholder
  rules-primitives-global-toggle primitive-kinds-apply-cancel-zero
  search-apply-clear-cancel tab-and-shift-tab-focus-ring left-right-direction-focus
  enter-navigation-rule-selected enter-navigation-effective-applicability
  enter-navigation-primitive-details enter-stays-in-applicability
  open-primitive-from-subject open-primitive-from-direction-panels
  open-primitive-from-applicability open-primitive-disabled-in-rule-details yaml-view
  rule-policy-type-column cilium-network-policy-details-and-yaml
  cilium-clusterwide-policy-details-and-yaml istio-authorization-policy-details-and-yaml
  istio-authorization-effective-deny yaml-hidden-without-a-manifest auto-refresh-toggle
  escape-clears-selection-before-back ctrl-s-set-subject-from-subject-panel
  ctrl-s-set-subject-from-applicability freeze-hang-stress
}
foreach pair $edge_pairs {
  foreach direction {ingress egress} { lappend known_cases "[lindex $pair 0]-$direction" }
}
foreach family {cnp ccnp} {
  foreach direction {ingress egress} { lappend known_cases "$family-empty-rule-$direction" }
}
lappend known_cases \
  cnp-ingress-rule-navigation cnp-egress-spec-rule-navigation \
  ccnp-ingress-spec-rule-navigation ccnp-egress-spec-rule-navigation \
  istio-ingress-rule-navigation native-egress-istio-opposite-navigation \
  istio-source-ingress-deny-egress-control cilium-cidr-narrow-deny
set case_manifest [dict create known $known_cases \
  identity {istio-identity-ingress-partial-data istio-identity-egress-partial-data} \
  unsupported {unsupported-cilium-rule-details unsupported-snapshot-egress-partial-data}]
if {!$syntax_only && [info exists env(EXPECT_CASE_MANIFEST)] && $env(EXPECT_CASE_MANIFEST) eq "1"} {
  foreach group {known identity unsupported} {
    foreach name [dict get $case_manifest $group] { puts "$group\t$name" }
  }
  exit 0
}
if {!$syntax_only} {
  if {![dict exists $case_manifest $suite]} { puts stderr "unknown smoke suite: $suite"; exit 2 }
  if {$suite ne "known" && $probe_id eq ""} { puts stderr "PROBE_ID is required for uncertainty suites"; exit 2 }
}

proc say {msg} { puts $msg }

proc fixture_text {value} {
  global prefix
  set monitoring demo-ccnp-monitoring
  if {$prefix ne "netpol-demo"} { set monitoring "${prefix}-ccnp-monitoring" }
  return [string map [list netpol-demo $prefix demo-ccnp-monitoring $monitoring] $value]
}

proc fail_case {msg} {
  global case_name failures case_failed case_verdict verdicts
  incr failures
  set case_failed 1
  dict set verdicts $case_name FAIL
  set case_verdict 1
  puts "FAIL $case_name: $msg"
}

proc fail_case_dump {msg} {
  global container
  fail_case $msg
  catch {exec docker kill -s QUIT $container} dump
  if {[info exists dump] && $dump ne ""} { puts $dump }
}

proc pass_case {} {
  global case_name case_failed case_verdict verdicts
  if {$case_failed} { return }
  dict set verdicts $case_name PASS
  set case_verdict 1
  puts "PASS $case_name"
}

# close_case guarantees every started case records a verdict. A case that falls
# through its assertions without calling pass_case or fail_case would otherwise
# disappear from the run entirely and still report success.
proc close_case {} {
  global case_name case_verdict
  if {!$case_verdict} {
    fail_case "case ended without reporting a verdict"
  }
}

proc start_case {name {reset 1}} {
  global case_name case_failed case_verdict ns_app started_cases case_manifest suite
  close_case
  set case_name $name
  set case_failed 0
  set case_verdict 0
  puts "CASE $case_name"
  if {![expr {$name in [dict get $case_manifest $suite]}] || [dict exists $started_cases $name]} {
    fail_case "unexpected or duplicate case in suite $suite"
  }
  dict set started_cases $name 1
  if {$reset && $name ne "launch-npg-view"} {
    send -- ":npg deployment api $ns_app\r"
    after 1200
  }
}

proc drain {{quiet_seconds 1}} {
  set old_timeout $::timeout
  set drained 1
  while {$drained} {
    set drained 0
    set ::timeout $quiet_seconds
    expect {
      -re {(.|\r|\n)+} { set drained 1 }
      timeout {}
      eof { set ::timeout $old_timeout; return 0 }
    }
  }
  set ::timeout $old_timeout
  return 1
}

# A TUI only emits the cells that changed, so assertions that match steady-state
# text would otherwise time out. Nudging the pty size makes tview repaint the
# whole screen, which puts the current view back on the wire.
proc repaint {} {
  global spawn_out screen_rows screen_columns
  catch {exec stty rows [expr {$screen_rows - 1}] columns $screen_columns < $spawn_out(slave,name)}
  after 200
  catch {exec stty rows $screen_rows columns $screen_columns < $spawn_out(slave,name)}
  after 300
}

proc wait_stream {pattern {seconds 20}} {
  set pattern [fixture_text $pattern]
  set old_timeout $::timeout
  set ::timeout $seconds
  expect {
    -re $pattern { set ::timeout $old_timeout; return 1 }
    timeout { set ::timeout $old_timeout; fail_case "timed out waiting for /$pattern/"; return 0 }
    eof { set ::timeout $old_timeout; fail_case "process exited while waiting for /$pattern/"; return 0 }
  }
}

proc assert_screen {pattern {seconds 20}} {
  drain 1
  repaint
  return [wait_stream $pattern $seconds]
}

proc send_key {keys {pause_ms 250}} {
  send -- [fixture_text $keys]
  after $pause_ms
}

proc assert_reachability_view {{seconds 20}} {
  return [assert_screen {<npg>|Deployment netpol-demo-app/api|Subject} $seconds]
}

proc assert_all_screen {patterns {seconds 20}} {
  set ok 1
  foreach pattern $patterns {
    if {![assert_screen $pattern $seconds]} { set ok 0 }
  }
  return $ok
}

proc screen_matches {pattern {seconds 5}} {
  set pattern [fixture_text $pattern]
  drain 1
  repaint
  set old_timeout $::timeout
  set ::timeout $seconds
  expect {
    -re $pattern { set ::timeout $old_timeout; return 1 }
    timeout { set ::timeout $old_timeout; return 0 }
    eof { set ::timeout $old_timeout; return 0 }
  }
}

proc ensure_rules {} {
  if {![screen_matches {Ingress · Rules} 5]} { send_key "m" 400 }
  assert_screen {Ingress · Rules} 15
}

proc ensure_primitives {} {
  if {![screen_matches {Ingress · Primitives} 5]} { send_key "m" 400 }
  assert_screen {Ingress · Primitives} 15
}

proc verify_custom_policy_rule {policy type_pattern api_pattern resource_pattern peer_pattern port_pattern} {
  ensure_rules
  focus_ingress
  send_key "/"
  if {![assert_screen {Reachability Search|Filter:} 10]} { return }
  send_key $policy
  send_key "\t"
  send_key "\r"
  if {![assert_screen $policy 15]} { return }
  send_key "\033\[B"
  if {![assert_all_screen [list $policy $type_pattern {Rule Details} {<o>} {<y>}] 20]} { return }
  send_key "o"
  if {![assert_screen $resource_pattern 20]} { return }
  send_key "\033"
  send_key "y"
  if {![assert_screen $api_pattern 20]} { return }
  send_key "\033"
  send_key "\r"
  if {![assert_screen {Applicability \(Ingress\)} 15]} { return }
  send_key "/"
  if {![assert_screen {Reachability Search|Filter:} 10]} { return }
  send_key $peer_pattern
  send_key "\t"
  send_key "\r"
  if {![assert_all_screen [list $peer_pattern {Allowed} $port_pattern] 20]} { return }
  finish_case
}

proc verify_rule_type_column {policy rendered_name type_pattern port_pattern} {
  send_key "/"
  if {![assert_screen {Reachability Search|Filter:} 10]} { return 0 }
  send_key $policy
  send_key "\t"
  send_key "\r"
  set row_pattern "${rendered_name}(.|\r|\n)*${type_pattern}(.|\r|\n)*${port_pattern}"
  if {![assert_screen $row_pattern 20]} { return 0 }
  send_key "/"
  if {![assert_screen {Filter:} 10]} { return 0 }
  send_key "\t\t"
  send_key "\r"
  return [assert_screen {Ingress · Rules} 10]
}

# The view opens focused on the subject panel, which is where the Tab ring
# starts. Cases that drive a direction panel -- Open Primitive, YAML, Enter
# navigation -- have to move focus there first. Left is honoured from the
# subject but deliberately ignored once focus sits inside the detail pane, so
# this only works on a freshly opened view, which start_case guarantees.
proc focus_ingress {} {
  send_key "\033\[D" 250
}

proc select_direction_row_with_hint {pattern description {max_moves 30}} {
  for {set moves 0} {$moves < $max_moves} {incr moves} {
    if {[screen_matches $pattern 1]} { return 1 }
    send_key "\033\[B" 150
  }
  fail_case "could not find $description"
  return 0
}

proc assert_native_primitive_view {{seconds 20}} {
  return [assert_screen {Pods|pods\(|Namespaces|namespaces\(|Deployments|deployments\(|Jobs|jobs\(|Viewing v1/pods|Viewing v1/namespaces|Viewing apps/v1/deployments|Viewing batch/v1/jobs} $seconds]
}

proc assert_network_policy_view {{seconds 20}} {
  return [assert_screen {networkpolicies\(|Viewing networking\.k8s\.io/v1/networkpolicies} $seconds]
}

proc finish_case {} {
  assert_reachability_view 20
  pass_case
}

if {$syntax_only} {
  if {[llength [info commands ::tcl::unsupported::disassemble]] == 0} {
    puts stderr "Tcl bytecode inspection is required for non-executing syntax validation"
    exit 1
  }
  set syntax_opcode {^[[:space:]]*\([0-9]+\) syntax(?:[[:space:]]|$)}
  dict for {path source_text} $syntax_sources {
    proc __netpol_syntax_file {} $source_text
    if {[catch {::tcl::unsupported::disassemble proc __netpol_syntax_file} compiled] ||
        [regexp -line $syntax_opcode $compiled]} {
      puts stderr "invalid Tcl syntax in $path"
      exit 1
    }
  }
  rename __netpol_syntax_file ""
  foreach name [info procs] {
    if {$name in $initial_procs} { continue }
    if {[catch {::tcl::unsupported::disassemble proc $name} compiled] ||
        [regexp -line $syntax_opcode $compiled]} {
      puts stderr "invalid Tcl syntax in procedure $name"
      exit 1
    }
  }
  puts "whole-file Tcl syntax and procedure bodies checked"
  exit 0
}

# The kind API server certificate only covers the control-plane container name,
# so the container joins the kind network and uses the internal kubeconfig.
set docker_args [list docker run --rm -it --name $container --network $network -e TERM=xterm-256color -e KUBECONFIG=/root/.kube/config -v ${kubeconfig}:/root/.kube/config:ro]
lappend docker_args $image --readonly -c "npg deployment api $ns_app"

file mkdir $log_dir
log_file -a "$log_dir/k9s-tui-smoke-$suite.session.log"
# Expect inherits a 0x0 pty when it runs without a controlling terminal, and a
# zero-sized screen makes the TUI draw nothing at all. Size it explicitly.
set stty_init "rows 50 cols 200"
say "spawning: $docker_args"
spawn {*}$docker_args
match_max 262144
stty rows 50 columns 200 < $spawn_out(slave,name)

if {$suite eq "known"} {
start_case "launch-npg-view"
if {[assert_all_screen {Subject {Deployment netpol-demo-app/api} {3 pods} {Ingress on} {Egress on} {Kinds: CIDR,Pod,Namespace,Deployment,Job} {Auto-refresh off} {Ingress · Rules} {Egress · Rules} {Selection: none} {Effective Details} {Effective Applicability \(Ingress\)} {read-only graph} {</>} Search {<npg>}} 45]} {
  if {[screen_matches {<ctrl-r>} 2]} {
    fail_case "manual Refresh shortcut remained visible"
  } else {
    pass_case
  }
}

start_case "subject-picker-kinds"
send_key "s"
if {[assert_all_screen {{<Subject>} Kinds Subjects} 15]} {
  # Esc is the dialog cancel key. Verify it returns to the graph rather than
  # popping the root netpol view.
  send_key "\033"
  finish_case
}

start_case "direction-toggles-placeholder"
send_key "i"
assert_screen {Egress · Rules} 10
send_key "e"
if {[assert_screen {Both directions are hidden\. Press i for ingress or e for egress\.} 10]} {
  # The placeholder itself does not own the graph key bindings reliably in all tview focus states, so reset through the command prompt after proving the hidden state.
  send -- ":npg deployment api $ns_app\r"
  after 1200
  assert_all_screen {{Ingress · Rules} {Egress · Rules}} 10
  pass_case
}

start_case "rules-primitives-global-toggle"
send_key "m"
if {[assert_all_screen {{Ingress · Primitives} {Egress · Primitives} {Effective Details} {Selection: none}} 15]} {
  if {[screen_matches {Effective Applicability} 2]} {
    fail_case "Effective Applicability remained visible in Primitives mode"
  } else {
    send_key "m"
    assert_all_screen {{Ingress · Rules} {Egress · Rules}} 15
    pass_case
  }
}

start_case "primitive-kinds-apply-cancel-zero"
ensure_rules
send_key "m"
send_key "p"
if {[assert_all_screen {{Primitive Kinds} CIDR Pod Namespace Deployment Job Apply Cancel} 10]} {
  # All controls, including both buttons, must fit at 50x200 before any arrow
  # key can scroll the form.
  # Clear all five checkboxes, tab to Apply, press Enter.
  for {set i 0} {$i < 5} {incr i} { send_key " " 100; send_key "\t" 100 }
  send_key "\r"
  assert_screen {No primitive kinds selected\. Press p to enable kinds\.} 10
  send_key "p"
  assert_screen {Primitive Kinds} 10
  send_key "\033"
  assert_screen {No primitive kinds selected\. Press p to enable kinds\.} 10
  send_key "p"
  for {set i 0} {$i < 5} {incr i} { send_key " " 100; send_key "\t" 100 }
  send_key "\r"
  send_key "m"
  assert_all_screen {{Ingress · Rules} {Egress · Rules}} 15
  pass_case
}

start_case "search-apply-clear-cancel"
ensure_rules
send_key "/"
if {[assert_screen {Reachability Search|Filter:} 10]} {
  send_key "frontend"
  send_key "\t"
  send_key "\r"
  assert_screen {filter: frontend|frontend} 10
  send_key "/"
  assert_screen {Filter:} 10
  send_key "\t\t"
  send_key "\r"
  assert_screen {Ingress · Rules|Egress · Rules} 10
  send_key "/"
  assert_screen {Filter:} 10
  send_key "\033"
  finish_case
}

start_case "tab-and-shift-tab-focus-ring"
# The ring pairs each direction with its own detail stops: subject, ingress,
# ingress details, ingress applicability, then the same three for egress. Three
# tabs must therefore reach the ingress applicability without ever passing
# through the egress panel.
for {set i 0} {$i < 3} {incr i} { send_key "\t" 150 }
assert_all_screen {{Applicability \(Ingress\)} Primitive Peer Opposite State Ports} 15
for {set i 0} {$i < 3} {incr i} { send_key "\033\[Z" 150 }
assert_all_screen {Subject Ingress Egress {Effective Details} {Effective Applicability \(Ingress\)}} 10
pass_case

start_case "left-right-direction-focus"
# The view opens on the subject panel, from which Left and Right move focus
# straight onto a direction panel.
send_key "\033\[D"
assert_screen {Ingress · Rules} 10
send_key "\033\[C"
assert_screen {Egress · Rules} 10
pass_case

start_case "enter-navigation-rule-selected"
ensure_rules
# From a direction panel in Rules mode, Enter focuses Applicability.
focus_ingress
send_key "\033\[B"
send_key "\r"
assert_all_screen {{Applicability \(Ingress\)} Primitive Peer Opposite State Ports} 15
pass_case

start_case "enter-navigation-effective-applicability"
ensure_rules
# Cover the other direction: the graph opens without a selected rule, so Enter
# on Egress focuses its effective applicability table directly.
send_key "\033\[C"
assert_screen {Effective Details|Selection: none} 15
assert_screen {Effective Applicability \(Egress\)} 15
send_key "\r"
assert_all_screen {{Effective Applicability \(Egress\)} Primitive Peer Opposite State Ports} 15
pass_case

start_case "enter-navigation-primitive-details"
ensure_primitives
# Select a native primitive, then Enter focuses its text detail pane (there is
# no applicability table in this projection). The same selected primitive must
# remain openable with lowercase o from Primitive Details.
focus_ingress
assert_screen {Ingress · Primitives} 15
if {[select_direction_row_with_hint {Open Primitive} "a native ingress primitive"]} {
  assert_screen {Primitive Details} 15
  send_key "\r"
  if {[assert_all_screen {{Primitive Details} {Direction: Ingress|Coverage:} {<o>} {Open Primitive}} 15]} {
    send_key "o"
    if {[assert_native_primitive_view 20]} {
      send_key "\033"
      finish_case
    }
  }
}

start_case "enter-stays-in-applicability"
ensure_rules
focus_ingress
# Enter on a direction still focuses Applicability. Once there, move to any
# native primitive advertised as openable and prove a second Enter stays put;
# resource opening from Applicability belongs exclusively to lowercase o.
assert_screen {Ingress · Rules} 15
send_key "\r"
assert_screen {Applicability \(Ingress\)} 15
if {[select_direction_row_with_hint {Open Primitive} "a native applicability primitive"]} {
  send_key "\r"
  if {[assert_all_screen {{Applicability \(Ingress\)} {<o>} {Open Primitive}} 15]} {
    pass_case
  }
}

start_case "open-primitive-from-subject"
ensure_rules
# The default Subject selection is a native Pod workload. The exact header hint
# is both the eligibility assertion and the stable signal that the row loaded.
if {[assert_all_screen {{Pod[[:space:]]+netpol-demo-app[[:space:]]+api-} {<o>} {Open Primitive}} 30]} {
  send_key "o"
  if {[assert_native_primitive_view 20]} {
    send_key "\033"
    finish_case
  }
}

start_case "open-primitive-from-direction-panels"
ensure_rules
focus_ingress
# Rules rows resolve to their native NetworkPolicy. Select by the renamed action
# hint rather than row position so synthetic rows and ordering do not make the
# smoke brittle, and exercise both direction panels independently.
if {[select_direction_row_with_hint {Open Primitive} "an ingress NetworkPolicy"]} {
  if {[assert_screen {<o>} 10]} {
    send_key "o"
    if {[assert_network_policy_view 20]} {
      send_key "\033"
      assert_screen {Ingress · Rules} 20
      send_key "\033\[C"
      assert_screen {Egress · Rules} 15
      if {[select_direction_row_with_hint {Open Primitive} "an egress NetworkPolicy"]} {
        if {[assert_screen {<o>} 10]} {
          send_key "o"
          if {[assert_network_policy_view 20]} {
            send_key "\033"
            finish_case
          }
        }
      }
    }
  }
}

start_case "open-primitive-from-applicability"
ensure_rules
focus_ingress
send_key "\r"
assert_screen {Effective Applicability \(Ingress\)} 15
if {[select_direction_row_with_hint {Open Primitive} "a native applicability primitive"]} {
  if {[assert_screen {<o>} 10]} {
    send_key "o"
    if {[assert_native_primitive_view 20]} {
      send_key "\033"
      finish_case
    }
  }
}

start_case "open-primitive-disabled-in-rule-details"
ensure_rules
focus_ingress
# A real rule supplies stable Rule Details, but that text pane is not itself a
# primitive selection. Lowercase o must be absent and must leave the pane open.
if {[select_direction_row_with_hint {<y>} "a real rule with Rule Details"]} {
  send_key "\t"
  if {[assert_screen {Rule Details} 15]} {
    if {[screen_matches {<o>} 3] || [screen_matches {Open Primitive} 3]} {
      fail_case "Open Primitive is advertised in Rule Details"
    } else {
      send_key "o"
      if {[assert_screen {Rule Details} 10]} {
        if {[screen_matches {<o>} 2] || [screen_matches {Open Primitive} 2]} {
          fail_case "Open Primitive became available in Rule Details"
        } else {
          pass_case
        }
      }
    }
  }
}

start_case "yaml-view"
ensure_rules
focus_ingress
# Only a real rule has a manifest, so navigate by the advertised action rather
# than assuming a fixed rule row.
if {[select_direction_row_with_hint {<y>} "a real rule with the YAML hint"]} {
  send_key "y"
  if {[assert_screen {apiVersion|networking\.k8s\.io|YAML} 20]} {
    send_key "\033"
    finish_case
  }
}

start_case "rule-policy-type-column"
ensure_rules
focus_ingress
set type_column_ok 1
foreach {policy rendered_name type_pattern port_pattern} {
  allow-authz-probe-ingress {netpol-demo-app/allow-authz-probe-ingress #0} {NetworkPolicy} {TCP/7070}
  demo-cnp-frontend {netpol-demo-app/demo-cnp-frontend #0} {CiliumNetworkPolicy} {TCP/8080}
  demo-ccnp-monitoring {demo-ccnp-monitoring #0} {CiliumClusterwideNetworkPolicy} {TCP/9090}
  demo-authz-api {netpol-demo-app/demo-authz-api #0} {AuthorizationPolicy} {TCP/8080}
} {
  if {![verify_rule_type_column $policy $rendered_name $type_pattern $port_pattern]} {
    set type_column_ok 0
    break
  }
}
if {$type_column_ok} { finish_case }

start_case "cilium-network-policy-details-and-yaml"
verify_custom_policy_rule demo-cnp-frontend {Policy type: CiliumNetworkPolicy} {cilium\.io/v2} {ciliumnetworkpolicies|Viewing cilium\.io/v2/ciliumnetworkpolicies} {Deployment netpol-demo-web/frontend} {TCP/8080}

start_case "cilium-clusterwide-policy-details-and-yaml"
verify_custom_policy_rule demo-ccnp-monitoring {Policy type: CiliumClusterwideNetworkPolicy} {cilium\.io/v2} {ciliumclusterwidenetworkpolicies|Viewing cilium\.io/v2/ciliumclusterwidenetworkpolicies} {Deployment netpol-demo-monitoring/prometheus} {TCP/9090}

start_case "istio-authorization-policy-details-and-yaml"
verify_custom_policy_rule demo-authz-api {Policy type: AuthorizationPolicy} {security\.istio\.io/v1} {authorizationpolicies|Viewing security\.istio\.io/v1/authorizationpolicies} {Deployment netpol-demo-web/frontend} {TCP/8080}

start_case "istio-authorization-effective-deny"
ensure_rules
focus_ingress
send_key "\r"
if {[assert_screen {Effective Applicability \(Ingress\)} 15]} {
  send_key "/"
  if {[assert_screen {Reachability Search|Filter:} 10]} {
    send_key "Deployment netpol-demo-open/open-app"
    send_key "\t"
    send_key "\r"
    if {[assert_all_screen {{Deployment netpol-demo-open/open-app} {Disallowed} {no ports}} 20]} {
      pass_case
    }
  }
}

start_case "yaml-hidden-without-a-manifest"
ensure_rules
focus_ingress
# The synthetic default-deny row references no NetworkPolicy.
send_key "\033\[B"
if {[screen_matches {<y>} 5]} {
  fail_case "YAML is advertised for the synthetic default-deny row"
} elseif {[select_direction_row_with_hint {<y>} "a real rule with the YAML hint"]} {
  # Filter the applicability table to a CIDR so selection does not depend on
  # how many CIDR policies the custom-policy fixtures add.
  send_key "\r"
  if {[assert_screen {Applicability \(Ingress\)} 15]} {
    send_key "/"
    if {[assert_screen {Reachability Search|Filter:} 10]} {
      send_key "CIDR 192.168.0.0/16"
      send_key "\t"
      send_key "\r"
      if {[assert_screen {CIDR 192\.168\.0\.0/16} 15]} {
        if {[screen_matches {<y>} 5]} {
          fail_case "YAML is advertised for a CIDR applicability row"
        } else {
          send_key "/"
          assert_screen {Filter:} 10
          send_key "\t\t"
          send_key "\r"
          if {[select_direction_row_with_hint {<y>} "a resource applicability row with the YAML hint"]} {
            pass_case
          }
        }
      }
    }
  }
}

start_case "auto-refresh-toggle"
ensure_rules
send_key "r"
wait_stream {Auto-refresh is enabled|Auto-refresh on|Auto-refresh} 10
send_key "r"
if {[wait_stream {Auto-refresh is disabled|Auto-refresh off|Auto-refresh} 10]} { finish_case }

start_case "escape-clears-selection-before-back"
ensure_rules
focus_ingress
send_key "\033\[B"
send_key "\033"
assert_screen {Effective Details.*Effective Applicability \(Ingress\)|Selection: none} 15
pass_case

start_case "ctrl-s-set-subject-from-subject-panel"
ensure_rules
if {[assert_all_screen {{<ctrl-s>} {Set As Subject} {Pod[[:space:]]+netpol-demo-app[[:space:]]+api-}} 30]} {
  # Ctrl-S is delivered directly by the legacy tcell key map.
  send_key "\023" 500
  if {[assert_all_screen {Subject {Pod netpol-demo-app/api-[[:alnum:]-]+ · 1 pod} {<ctrl-s>} {Set As Subject}} 45]} {
    pass_case
  }
}

start_case "ctrl-s-set-subject-from-applicability"
ensure_rules
focus_ingress
assert_all_screen {{Selection: none} {Effective Applicability \(Ingress\)}} 15
send_key "\r"
assert_screen {Effective Applicability \(Ingress\)} 15
# Filter to one known subject-capable primitive instead of relying on a fixed
# applicability row count or ordering.
send_key "/"
if {[assert_screen {Reachability Search|Filter:} 10]} {
  send_key "Deployment netpol-demo-web/frontend"
  send_key "\t"
  send_key "\r"
  if {[assert_all_screen {{Effective Applicability \(Ingress\).*filter: Deployment netpol-demo-web/frontend} {Deployment netpol-demo-web/frontend}} 20]} {
    if {[assert_all_screen {{<ctrl-s>} {Set As Subject}} 15]} {
      send_key "\023" 500
      if {[assert_all_screen {Subject {Deployment netpol-demo-web/frontend · 2 pods} {<ctrl-s>} {Set As Subject}} 45]} {
        pass_case
      }
    }
  }
}

start_case "freeze-hang-stress"
# Mash the keys that touch the evaluator, the panels and the auto-refresh loop. The
# UI thread used to block on informer lists here, which stalled every repaint.
for {set i 0} {$i < 80} {incr i} {
  send -- "\033\[A\033\[Brm\033\[5~\033\[6~"
  after 40
}
# Drain everything already buffered so the probe below can only be satisfied by
# a fresh repaint rather than by stale output.
drain 1
# A live TUI repaints as soon as it is poked; a deadlocked one never answers.
repaint
send -- "r"
after 200
send -- "\033\[A"
set timeout 30
expect {
  -re {Subject|Ingress|Egress|Details|Primitives|Rules} { pass_case }
  timeout { fail_case_dump "TUI stopped repainting after the stress loop; sent SIGQUIT to container" }
  eof { fail_case "process exited during stress" }
}
set timeout 10

foreach pair $edge_pairs {
  lassign $pair name source source_namespace destination destination_namespace state ports
  verify_effective_edge "$name-ingress" $destination $destination_namespace Ingress $source $source_namespace $state $ports
  verify_effective_edge "$name-egress" $source $source_namespace Egress $destination $destination_namespace $state $ports
}
foreach family {cnp ccnp} {
  foreach direction {Ingress Egress} {
    verify_effective_edge "$family-empty-rule-[string tolower $direction]" "$family-empty" $ns_edge_src $direction control $ns_edge_other Disallowed {no ports}
  }
}
verify_edge_policy cnp-ingress-rule-navigation cnp-server $ns_edge_dst Ingress cnp-target $ns_edge_dst CiliumNetworkPolicy cilium.io/v2 ciliumnetworkpolicies ALLOW {TCP/8081-8082} cnp-client $ns_edge_src {TCP/8081}
verify_edge_policy cnp-egress-spec-rule-navigation cnp-client $ns_edge_src Egress cnp-source $ns_edge_src CiliumNetworkPolicy cilium.io/v2 ciliumnetworkpolicies ALLOW {TCP/8080-8081} cnp-server $ns_edge_dst {TCP/8081}
verify_edge_policy ccnp-ingress-spec-rule-navigation ccnp-server $ns_edge_dst Ingress "${prefix}-edge-ccnp" "" CiliumClusterwideNetworkPolicy cilium.io/v2 ciliumclusterwidenetworkpolicies ALLOW {TCP/9091-9092} ccnp-client $ns_edge_src {TCP/9092}
verify_edge_policy ccnp-egress-spec-rule-navigation ccnp-client $ns_edge_src Egress "${prefix}-edge-ccnp" "" CiliumClusterwideNetworkPolicy cilium.io/v2 ciliumclusterwidenetworkpolicies ALLOW {TCP/9090-9092} ccnp-server $ns_edge_dst {TCP/9092}
verify_edge_policy istio-ingress-rule-navigation authz-server $ns_edge_dst Ingress authz-ports-allow $ns_edge_dst AuthorizationPolicy security.istio.io/v1 authorizationpolicies ALLOW {TCP/8080-8081} authz-client $ns_edge_src {TCP/8080}
verify_edge_policy native-egress-istio-opposite-navigation authz-client $ns_edge_src Egress authz-source-network $ns_edge_src NetworkPolicy networking.k8s.io/v1 networkpolicies ALLOW {TCP/8080-8081, UDP/5353, SCTP/9000} authz-server $ns_edge_dst {TCP/8080, UDP/5353, SCTP/9000}
verify_source_authz_noninterference
verify_cidr_narrow_deny
} elseif {$suite eq "identity"} {
  verify_identity_edge Ingress
  verify_identity_edge Egress
} else {
  verify_unsupported_policy
  verify_effective_edge unsupported-snapshot-egress-partial-data cnp-client $ns_edge_src Egress cnp-server $ns_edge_dst {Partial Data} {TCP/8081} 1
}

send_key "q"
expect {
  eof {}
  timeout { catch {exec docker kill $container} }
}

close_case
foreach name [dict get $case_manifest $suite] {
  if {![dict exists $verdicts $name]} {
    dict set verdicts $name FAIL
    incr failures
    puts "FAIL $name: expected case never recorded a verdict"
  }
}

# Authoritative summary. Mid-run output interleaves with the TUI's own redraw
# bytes, so per-case lines are unreliable to parse; this block is not.
puts "=== smoke case summary ==="
puts "suite: $suite"
set verdict_file [open "$log_dir/smoke-$suite.verdicts" w]
dict for {name verdict} $verdicts {
  puts [format "  %-6s %s" $verdict $name]
  puts $verdict_file "$verdict\t$name"
}
close $verdict_file
puts [format "=== %d case(s), %d failure(s) ===" [dict size $verdicts] $failures]

if {$failures > 0} {
  puts "FAILED $failures smoke assertion(s)"
  exit 1
}
puts "all smoke cases passed"
